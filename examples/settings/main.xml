<Screen version="1" id="settings-screen" stylesheet="example:assets/theme.css">
 <Column anchor="center" class="card" style="width: 600dp; gap: 18dp">
  <Text class="title" value="Settings / Настройки"/>
  <Text class="subtitle" value="Observable values, explicit writable bindings"/>
  <Text value="Display name"/><TextInput id="name" value="{settings.name}" writable="true" placeholder="Your name / Ваше имя" style="width: 100%"/>
  <Row style="gap: 20dp"><Text value="Music"/><Toggle id="music" value="{settings.music}" writable="true"/></Row>
  <Text value="Volume"/><Slider id="volume" value="{settings.volume}" writable="true" min="0" max="1" step="0.05" style="width: 100%; height: 24dp"/>
  <Text value="Quality (activate to cycle)"/><Select id="quality" value="{settings.quality}" writable="true" options="Low|Medium|High" style="width: 100%"/>
  <Button action="example:apply" class="primary">Apply / Применить</Button>
 </Column>
</Screen>
