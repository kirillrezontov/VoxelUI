<Screen version="1" id="world-selection" stylesheet="example:assets/theme.css">
 <Template name="WorldCard"><Button id="world" action="example:open_world" worldId="{props.worldId}" style="width: 100%; height: 112dp; padding: 12dp"><Row style="gap: 20dp"><Image source="{props.image}" style="width: 132dp; height: 86dp"/><Column><Text value="{props.title}" style="font-size: 22dp"/><Text value="{props.subtitle}" class="subtitle"/></Column></Row></Button></Template>
 <Column style="padding: 28dp; width: 100%">
  <Text class="title" value="Your worlds / Миры"/><Text class="subtitle" value="Keyed mock collection · scroll and keyboard focus survive safe reload"/>
  <ScrollView id="world-scroll" style="height: 460dp; width: 100%; gap: 12dp">
   <Repeat id="worlds" items="{worlds.available}" key="id"><Component template="WorldCard" title="{item.name}" subtitle="{item.subtitle}" worldId="{item.id}" image="{item.icon}"/></Repeat>
  </ScrollView>
 </Column>
</Screen>
