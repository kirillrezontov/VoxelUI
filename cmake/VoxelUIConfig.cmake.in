@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(LibXml2 2.9)
find_dependency(Freetype 2.10)
find_dependency(PNG 1.6)
if(@VOXELUI_VULKAN@)
  find_dependency(Vulkan 1.3)
  set(VoxelUI_vulkan_FOUND TRUE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VoxelUITargets.cmake")
set(VoxelUI_voxelui_FOUND TRUE)
set(VoxelUI_software_FOUND TRUE)
check_required_components(VoxelUI)
